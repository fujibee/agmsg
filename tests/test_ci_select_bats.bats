#!/usr/bin/env bats
#
# A pull request skips the bats files whose inputs its diff does not touch
# (.github/scripts/select-bats.mjs, driven by the traced table in
# bats-inputs.tsv). A skip that should not have happened is a green CI that
# stopped testing something, so these tests pin the direction every doubt leans:
# toward running the file.

setup() {
  REPO_ROOT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
  SELECT="$REPO_ROOT/.github/scripts/select-bats.mjs"
  SHARD="$REPO_ROOT/.github/scripts/shard-tests.sh"
  FIX="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$FIX/tests" "$FIX/scripts/drivers" "$FIX/app" "$FIX/docs" "$FIX/.github"
  local f
  for f in tests/a.bats tests/b.bats tests/c.bats tests/d.bats scripts/x.sh scripts/y.sh scripts/u.sh \
           scripts/drivers/k.sh scripts/orphan.sh app/z.ts docs/d.md README.md .github/w.yml; do
    printf 'x\n' > "$FIX/$f"
  done
  git -C "$FIX" init -q
  git -C "$FIX" add -A
  # a reads x.sh; b reads y.sh; c lists scripts/drivers; d installs from the repo.
  {
    printf '# generated by build-bats-inputs.mjs from 4 traced test files\n'
    printf 'U\tscripts/u.sh\n'
    printf 'F\ttests/a.bats\tscripts/x.sh\n'
    printf 'F\ttests/b.bats\tscripts/y.sh\n'
    printf 'D\ttests/c.bats\tscripts/drivers\n'
    printf 'C\ttests/d.bats\n'
  } > "$FIX/.github-map.tsv"
}

select_for() {
  printf '%s\n' "$@" > "$BATS_TEST_TMPDIR/changed.txt"
  run node "$SELECT" --root "$FIX" --map "$FIX/.github-map.tsv" --changed "$BATS_TEST_TMPDIR/changed.txt"
}

@test "a change only one test reads skips the tests that do not read it" {
  select_for scripts/x.sh
  [ "$status" -eq 0 ]
  printf '%s\n' "$output" | grep -qxF tests/b.bats
  printf '%s\n' "$output" | grep -qxF tests/c.bats
  # a reads it, and d installs from the repository, which includes it.
  run grep -cE 'tests/(a|d)\.bats' <<< "$output"
  [ "$output" = 0 ]
}

@test "a test file that is itself in the diff runs, and the others are skipped" {
  select_for tests/a.bats
  [ "$status" -eq 0 ]
  local out="$output"
  run grep -cxF tests/a.bats <<< "$out"
  [ "$output" = 0 ]
  printf '%s\n' "$out" | grep -qxF tests/b.bats
}

@test "a change outside the suite (app, docs, a README) skips every test" {
  select_for app/z.ts docs/d.md README.md
  [ "$status" -eq 0 ]
  [ "$(printf '%s\n' "$output" | grep -c .)" -eq 4 ]
}

@test "a file added to a directory a test lists runs that test, not the others" {
  mkdir -p "$FIX/scripts/drivers"
  printf 'x\n' > "$FIX/scripts/drivers/new.sh"
  git -C "$FIX" add -A
  select_for scripts/drivers/new.sh
  [ "$status" -eq 0 ]
  printf '%s\n' "$output" | grep -qxF tests/a.bats
  printf '%s\n' "$output" | grep -qxF tests/b.bats
  run grep -cxF tests/c.bats <<< "$output"
  [ "$output" = 0 ]
}

@test "a file read by nearly every test runs everything" {
  select_for scripts/u.sh
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "a tracked script no test was seen touching runs everything" {
  select_for scripts/orphan.sh
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "a change under .github runs everything" {
  select_for .github/w.yml
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "a deleted file runs everything" {
  select_for scripts/gone.sh
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "one doubtful path among clear ones still runs everything" {
  select_for docs/d.md scripts/orphan.sh
  [ "$status" -eq 0 ]
  [ -z "$output" ]
}

@test "a missing map fails with no output, so the caller runs everything" {
  printf '%s\n' scripts/x.sh > "$BATS_TEST_TMPDIR/changed.txt"
  run bash -c 'node "$1" --root "$2" --map "$2/no-such.tsv" --changed "$3" 2>/dev/null' _ "$SELECT" "$FIX" "$BATS_TEST_TMPDIR/changed.txt"
  [ "$status" -ne 0 ]
  [ -z "$output" ]
}

@test "an empty or unreadable changed list fails with no output" {
  : > "$BATS_TEST_TMPDIR/changed.txt"
  run bash -c 'node "$1" --root "$2" --map "$2/.github-map.tsv" --changed "$3" 2>/dev/null' _ "$SELECT" "$FIX" "$BATS_TEST_TMPDIR/changed.txt"
  [ "$status" -ne 0 ]
  [ -z "$output" ]
}

@test "the checked-in map names every test file in tests/ and the selector accepts it" {
  local n
  n="$(grep -v '^#' "$REPO_ROOT/.github/scripts/bats-inputs.tsv" | awk -F'\t' '$1=="F"||$1=="D"||$1=="C"{print $2}' | sort -u | wc -l | tr -d ' ')"
  # Every test file except the ones added after the map was traced (a file the
  # map does not name always runs, which is the safe direction).
  local missing
  missing="$(ls "$REPO_ROOT"/tests/*.bats | sed 's#.*/#tests/#' | while read -r t; do
    grep -qF "$t" "$REPO_ROOT/.github/scripts/bats-inputs.tsv" || printf '%s\n' "$t"
  done | grep -vc 'test_ci_select_bats' || true)"
  [ "$n" -ge 150 ]
  [ "${missing:-0}" -le 2 ]
  printf '%s\n' app/src/App.tsx > "$BATS_TEST_TMPDIR/changed.txt"
  run node "$SELECT" --root "$REPO_ROOT" --changed "$BATS_TEST_TMPDIR/changed.txt"
  [ "$status" -eq 0 ]
}

@test "shard-tests.sh partitions only what is not skipped, and covers all of it" {
  local skip="tests/test_install.bats,tests/test_spawn.bats" i all kept
  all="$(cd "$REPO_ROOT" && find tests -maxdepth 1 -name '*.bats' | LC_ALL=C sort)"
  kept="$(
    for i in 1 2 3 4 5 6; do
      (cd "$REPO_ROOT" && AGMSG_BATS_SKIP="$skip" bash "$SHARD" "$i" 6)
    done | LC_ALL=C sort
  )"
  [ "$(printf '%s\n' "$kept" | grep -c .)" -eq "$(( $(printf '%s\n' "$all" | grep -c .) - 2 ))" ]
  run grep -cE 'test_install\.bats|test_spawn\.bats' <<< "$kept"
  [ "$output" = 0 ]
}
