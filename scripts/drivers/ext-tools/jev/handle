#!/usr/bin/env bash
set -euo pipefail

# handle — ask a Jev decision endpoint one question about the agmsg
# message it receives, and reply with the answer. Two providers
# (maintainer decision, 2026-09-21): OpenRouter (the default, for
# existing members whose config carries no provider= line) and
# typesafe (TypeSafe's own native API). Auth and the request/response
# shape are the same for both; only the URL and the default model
# differ (see _lib.sh's _jev_provider_* helpers) -- and TypeSafe's own
# response carries no cost figure, so the reply line reports token
# counts there instead of a cost this script would otherwise have to
# derive itself from a published rate (never actually billed, so never
# shown next to a genuinely measured OpenRouter cost as if it were one).
#
# Contract (design note §3): stdin is one JSON object
#   {team, from, to, body, subject?, message_id, config_path}
# stdout is the reply body -- always exactly one line on success here (Jev is
# used with `ask`-style waiting, design note §6, not fire-and-forget like
# Slack). Exit 0 is success; non-zero is failure, and on failure this prints
# EXACTLY ONE line to stderr naming the reason -- agmsg wraps that into
# "<name>: 処理に失敗しました (<reason>)" itself, so this never fabricates that
# sentence or prints more than the one line.
#
# This one-line property holds NO MATTER WHAT the sender wrote in the
# message body -- a question's `choice` name is never validated (see
# below) and is echoed straight back by the endpoint, so it can carry
# anything, including an embedded newline. Every line this script ever
# prints, on either stream, is built into a variable and passed through
# _lib.sh's _jev_one_line as the last step before printing (see fail()
# and the reply construction at the bottom) -- that is the ONE place this
# property is enforced, not something re-derived per field or per call
# site (review finding, #1364, rounds 2-4: this used to get fixed one
# control character at a time, at the point each field was EXTRACTED,
# which just meant the next character reappeared at the same place).
#
# ONE accepted shape for `body` (maintainer decision, 2026-09-20 -- this
# replaces the earlier two-shape design, which also accepted plain text
# against a bundled example question type; that bundled-type mechanism
# (--question, tool.conf's default_question, examples/) is gone): JSON
# carrying "state" and "questions", {"state": ..., "questions": {...}} --
# passed to OpenRouter close to unchanged, the calling agent builds its
# own questions. Only checked here:
# body parses as JSON, and .questions is an object. The internal shape of
# each question is NOT validated; a malformed body still produces a
# one-line Jev-side error (from OpenRouter's own 400, not from this script
# guessing what is wrong). Anything else -- plain text, JSON without a
# "questions" key -- is refused, naming USAGE.md as where to read the
# accepted shape (see fail() calls below).
#
# The member config only ever names WHERE the key lives (key_file=...); the
# key itself is read once, held in a shell variable, and handed straight to
# curl's Authorization header. It is never echoed, logged, or included in
# the failure line.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_lib.sh"

# Not a trap: _jev_api_call sets and clears its OWN EXIT/INT/TERM trap around
# its temp work_dir (traps are process-global, so a trap set here would be
# silently overwritten -- or cleared -- by that inner call). Cheap enough to
# remove explicitly on every path instead, and $out_file never holds
# anything more sensitive than OpenRouter's own JSON response.
fail() {
  printf '%s\n' "$(_jev_one_line "$*")" >&2
  [ -n "${out_file:-}" ] && rm -f "$out_file"
  exit 1
}

input="$(cat)"
config_path="$(printf '%s' "$input" | jq -r '.config_path // empty' 2>/dev/null)" ||
  fail "jev: request is not valid JSON"
body="$(printf '%s' "$input" | jq -r '.body // empty')"

[ -n "$config_path" ] || fail "jev: request carries no config_path"
[ -f "$config_path" ] || fail "jev: member config not found: $config_path"

key_file="$(_jev_conf_get "$config_path" key_file)"
[ -n "$key_file" ] || fail "jev: member config is missing key_file: $config_path"

_jev_read_key "$key_file" || fail "jev: $_JEV_KEY_ERROR"
key="$_JEV_KEY"

# provider= is optional; an absent line means openrouter (existing configs
# predate this key entirely and must keep working unchanged).
provider="$(_jev_conf_get "$config_path" provider)"
[ -n "$provider" ] || provider="openrouter"
case "$provider" in
  openrouter|typesafe) : ;;
  *) fail "jev: member config has an unknown provider '$provider' (expected openrouter or typesafe)" ;;
esac

# The one accepted shape: body must parse as JSON AND carry a "questions"
# key. Anything else -- plain text, JSON without that key -- is refused
# here, naming the usage doc rather than guessing what the caller meant.
USAGE_HINT="send {\"state\": ..., \"questions\": {...}} as the body -- see drivers/ext-tools/jev/USAGE.md"
body_json=""
if ! body_json="$(printf '%s' "$body" | jq -e -c '.' 2>/dev/null)" ||
    ! printf '%s' "$body_json" | jq -e 'type == "object" and has("questions")' >/dev/null 2>&1; then
  fail "jev: $USAGE_HINT"
fi

questions_json="$(printf '%s' "$body_json" | jq -c '.questions')"
printf '%s' "$questions_json" | jq -e 'type == "object"' >/dev/null 2>&1 ||
  fail "jev: questions must be a JSON object -- $USAGE_HINT"
state_json="$(printf '%s' "$body_json" | jq -c '.state // ""')"

model="$(_jev_provider_default_model "$provider")"
request_json="$(jq -cn --arg model "$model" --argjson state "$state_json" \
  --argjson questions "$questions_json" '{model: $model, state: $state, questions: $questions}')"

url="$(_jev_api_base "$provider")$(_jev_provider_path "$provider")"
out_file="$(mktemp "${TMPDIR:-/tmp}/agmsg-jev-handle.XXXXXX")"

_jev_api_call "$key" "$request_json" "$out_file" "$url" ||
  fail "jev: request failed ($_JEV_CURL_DIAG)"

case "$_JEV_HTTP_CODE" in
  401) fail "jev: invalid API key (HTTP 401)" ;;
  429) fail "jev: rate limited (HTTP 429)" ;;
  2??) : ;;
  *) fail "jev: unexpected HTTP $_JEV_HTTP_CODE" ;;
esac

# Combine every answered question into one line: choices joined in the order
# the endpoint returned them, p/confidence as the product across questions
# (their joint, independence-assumed probability). Also pulls token counts
# alongside cost -- OpenRouter's response carries both, TypeSafe's carries
# only the tokens (no cost key at all), and which one the reply line shows
# is decided below by provider, not by whether cost happened to be present.
#
# Stays a JSON object all the way to the last moment, reading each field
# with its own `jq -r` call below, rather than flattening these fields into
# one delimited string first: a `choice` name comes from whatever
# `questions` the CALLER built and is echoed straight back by the API, so
# it can contain any byte a chosen delimiter might also use, corrupting
# which value ends up in which variable (review finding, #1364, round 2).
# jq's own JSON decoder draws each value's boundary here instead, so there
# is no delimiter for that data to collide with. (Line-safety -- keeping a
# `choice` name from breaking the ONE-LINE reply via an embedded newline --
# is a separate concern from this, and is _jev_one_line's job below, not
# this step's.)
result_json="$(jq -c '
  (.answers // {}) as $a
  | ($a | keys_unsorted) as $ks
  | if ($a | type) != "object" or ($ks | length) == 0 then empty else
      ( [$ks[] | $a[.].choice] ) as $choices
      | ( [$ks[] | ($a[.].probabilities[$a[.].choice] // null)] ) as $probs
      | ( [$ks[] | ($a[.].confidence // null)] ) as $confs
      | if ($choices | any(. == null)) or ($probs | any(. == null)) or ($confs | any(. == null)) then empty else
          {
            choices: ($choices | join(" / ")),
            p: ($probs | reduce .[] as $x (1; . * $x)),
            confidence: ($confs | reduce .[] as $x (1; . * $x)),
            cost: (.usage.cost // null),
            input_tokens: (.usage.input_tokens // null),
            output_tokens: (.usage.output_tokens // null)
          }
        end
    end
' "$out_file" 2>/dev/null)"
rm -f "$out_file"

[ -n "$result_json" ] || fail "jev: unexpected response shape"

choices="$(jq -r '.choices' <<<"$result_json")"
p_val="$(jq -r '.p' <<<"$result_json")"
c_val="$(jq -r '.confidence' <<<"$result_json")"
cost_val="$(jq -r '.cost // empty' <<<"$result_json")"
in_tokens="$(jq -r '.input_tokens // empty' <<<"$result_json")"
out_tokens="$(jq -r '.output_tokens // empty' <<<"$result_json")"
if [ "$provider" = "typesafe" ]; then
  [ -n "$in_tokens" ] && [ -n "$out_tokens" ] || fail "jev: unexpected response shape"
  printf -v reply_line 'jev: %s (choice p=%.2f, confidence=%.2f, tokens %s in / %s out)' \
    "$choices" "$p_val" "$c_val" "$in_tokens" "$out_tokens"
else
  [ -n "$cost_val" ] || fail "jev: unexpected response shape"
  printf -v reply_line 'jev: %s (choice p=%.2f, confidence=%.2f, cost $%.6f)' \
    "$choices" "$p_val" "$c_val" "$cost_val"
fi
printf '%s\n' "$(_jev_one_line "$reply_line")"
