#!/usr/bin/env bash
set -euo pipefail

# handle — ask a Jev decision endpoint one question about the agmsg
# message it receives, and reply with the answer. Two providers
# (maintainer decision, 2026-09-21): OpenRouter (the default, for
# existing members whose config carries no provider= line) and
# typesafe (TypeSafe's own native API). Auth and the request/response
# shape are the same for both; only the URL and the default model
# differ (see _lib.sh's _jev_provider_* helpers) -- and TypeSafe's own
# response carries no cost figure, so the reply line reports token
# counts there instead of a cost this script would otherwise have to
# derive itself from a published rate (never actually billed, so never
# shown next to a genuinely measured OpenRouter cost as if it were one).
#
# Contract (design note §3): stdin is one JSON object
#   {team, from, to, body, subject?, message_id, config_path}
# stdout is the reply body -- always exactly one line on success here (Jev is
# used with `ask`-style waiting, design note §6, not fire-and-forget like
# Slack). Exit 0 is success; non-zero is failure, and on failure this prints
# EXACTLY ONE line to stderr naming the reason -- agmsg wraps that into
# "<name>: 処理に失敗しました (<reason>)" itself, so this never fabricates that
# sentence or prints more than the one line.
#
# This one-line property holds NO MATTER WHAT the sender wrote in the
# message body -- a question's `choice` name is never validated (see
# below) and is echoed straight back by the endpoint, so it can carry
# anything, including an embedded newline. Every line this script ever
# prints, on either stream, is built into a variable and passed through
# _lib.sh's _jev_one_line as the last step before printing (see fail()
# and the reply construction at the bottom) -- that is the ONE place this
# property is enforced, not something re-derived per field or per call
# site (review finding, #1364, rounds 2-4: this used to get fixed one
# control character at a time, at the point each field was EXTRACTED,
# which just meant the next character reappeared at the same place).
#
# ONE accepted shape for `body` (maintainer decision, 2026-09-20 -- this
# replaces the earlier two-shape design, which also accepted plain text
# against a bundled example question type; that bundled-type mechanism
# (--question, tool.conf's default_question, examples/) is gone): JSON
# carrying "state" and "questions", {"state": ..., "questions": {...}} --
# passed to OpenRouter close to unchanged, the calling agent builds its
# own questions. Only checked here:
# body parses as JSON, and .questions is an object. The internal shape of
# each question is NOT validated; a malformed body still produces a
# one-line Jev-side error (from OpenRouter's own 400, not from this script
# guessing what is wrong). Anything else -- plain text, JSON without a
# "questions" key -- is refused, naming USAGE.md as where to read the
# accepted shape (see fail() calls below).
#
# The member config only ever names WHERE the key lives (key_file=...); the
# key itself is read once, held in a shell variable, and handed straight to
# curl's Authorization header. It is never echoed, logged, or included in
# the failure line.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_lib.sh"

# Not a trap: _jev_api_call sets and clears its OWN EXIT/INT/TERM trap around
# its temp work_dir (traps are process-global, so a trap set here would be
# silently overwritten -- or cleared -- by that inner call). Cheap enough to
# remove explicitly on every path instead, and $out_file never holds
# anything more sensitive than OpenRouter's own JSON response.
fail() {
  printf '%s\n' "$(_jev_one_line "$*")" >&2
  [ -n "${out_file:-}" ] && rm -f "$out_file"
  exit 1
}

input="$(cat)"
config_path="$(printf '%s' "$input" | jq -r '.config_path // empty' 2>/dev/null)" ||
  fail "jev: request is not valid JSON"
body="$(printf '%s' "$input" | jq -r '.body // empty')"

[ -n "$config_path" ] || fail "jev: request carries no config_path"
[ -f "$config_path" ] || fail "jev: member config not found: $config_path"

key_file="$(_jev_conf_get "$config_path" key_file)"
[ -n "$key_file" ] || fail "jev: member config is missing key_file: $config_path"

_jev_read_key "$key_file" || fail "jev: $_JEV_KEY_ERROR"
key="$_JEV_KEY"

# provider= is optional; an absent line means openrouter (existing configs
# predate this key entirely and must keep working unchanged).
provider="$(_jev_conf_get "$config_path" provider)"
[ -n "$provider" ] || provider="openrouter"
case "$provider" in
  openrouter|typesafe) : ;;
  *) fail "jev: member config has an unknown provider '$provider' (expected openrouter or typesafe)" ;;
esac

# The one accepted shape: body must parse as JSON AND carry a "questions"
# key. Anything else -- plain text, JSON without that key -- is refused
# here, naming the usage doc rather than guessing what the caller meant.
USAGE_HINT="send {\"state\": ..., \"questions\": {...}} as the body -- see drivers/ext-tools/jev/USAGE.md"
body_json=""
if ! body_json="$(printf '%s' "$body" | jq -e -c '.' 2>/dev/null)" ||
    ! printf '%s' "$body_json" | jq -e 'type == "object" and has("questions")' >/dev/null 2>&1; then
  fail "jev: $USAGE_HINT"
fi

questions_json="$(printf '%s' "$body_json" | jq -c '.questions')"
printf '%s' "$questions_json" | jq -e 'type == "object"' >/dev/null 2>&1 ||
  fail "jev: questions must be a JSON object -- $USAGE_HINT"
state_json="$(printf '%s' "$body_json" | jq -c '.state // ""')"

model="$(_jev_provider_default_model "$provider")"
request_json="$(jq -cn --arg model "$model" --argjson state "$state_json" \
  --argjson questions "$questions_json" '{model: $model, state: $state, questions: $questions}')"

url="$(_jev_api_base "$provider")$(_jev_provider_path "$provider")"
out_file="$(mktemp "${TMPDIR:-/tmp}/agmsg-jev-handle.XXXXXX")"

_jev_api_call "$key" "$request_json" "$out_file" "$url" ||
  fail "jev: request failed ($_JEV_CURL_DIAG)"

case "$_JEV_HTTP_CODE" in
  400)
    # The one 400 cause worth naming on its own: the request's total input
    # (state + every question's own criteria, repeated per question) went
    # over the provider's own limit. Checked against the error's own
    # `detail.error_type` field specifically, not a substring anywhere in
    # the body -- a substring match also fires on an unrelated 400 whose
    # free-text mentions this phrase without it being the actual cause
    # (review round 2). No partial match either way: both branches below
    # parse a complete, well-formed structure or produce false, never a
    # guess from whatever text happens to be present.
    #
    # TWO shapes reach that field, not one. `{"detail":{"error_type":
    # "max_tokens_exceeded"}}` at the TOP LEVEL is what a direct call
    # (TypeSafe's own API) returns. OpenRouter (the default provider) does
    # not: it wraps that exact same JSON as a STRING inside its own
    # error.message, prefixed with the HTTP status --
    #   {"error":{"message":"HTTP 400: {\"detail\":{\"error_type\":
    #   \"max_tokens_exceeded\"}}","code":400}}
    # -- confirmed directly against the real OpenRouter API, 2026-09-24
    # (a 400 carries no charge). The earlier top-level-only check missed
    # every OpenRouter over-limit 400 for exactly this reason (a Banking77
    # call at 100 questions fell through to the generic line below
    # instead). Both shapes are checked; anything that fails to parse as
    # either -- including a message that merely mentions the phrase
    # without carrying this exact structure -- is `false`, not a guess.
    #
    # NEITHER comparison below uses `// empty` before `==` (the shape the
    # round-2 review version had): in jq, `(X // empty) == Y` produces NO
    # OUTPUT AT ALL when X is null/false, not `false` -- `empty` is a
    # zero-output generator, and comparing against zero outputs yields
    # zero outputs, which `jq -e` treats the same as any other non-true
    # result but which silently skipped this whole branch's `if` even for
    # the flat TypeSafe shape whenever "detail" was absent (measured while
    # fixing this: the previously-shipped filter produced nothing, not
    # false, for exactly the OpenRouter body this fix is for). Comparing
    # directly with `==` already treats a missing/null field as `false`
    # correctly, no default needed. The nested capture below has the same
    # class of gap for a NON-matching regex -- capture on no match yields
    # no output rather than raising a catchable error, so `try/catch`
    # alone does not stand in for it -- caught instead with `// {j: null}`
    # before anything tries to parse `$cap.j`.
    if jq -e '
      def flat: (.detail.error_type == "max_tokens_exceeded");
      if flat then true else
        (((.error.message // "") | capture("^HTTP 400: (?<j>.*)$")) // {j: null}) as $cap
        | if ($cap.j == null) then false
          else try (($cap.j | fromjson).detail.error_type == "max_tokens_exceeded") catch false
          end
      end
    ' "$out_file" >/dev/null 2>&1; then
      fail "jev: request too large for one call (max_tokens_exceeded) -- split the questions into smaller batches"
    fi
    fail "jev: unexpected HTTP 400"
    ;;
  401) fail "jev: invalid API key (HTTP 401)" ;;
  429) fail "jev: rate limited (HTTP 429)" ;;
  2??) : ;;
  *) fail "jev: unexpected HTTP $_JEV_HTTP_CODE" ;;
esac

# Build one row per answered question -- name, choice, its OWN probability,
# its OWN confidence -- rather than one number for the whole call. An
# earlier version multiplied every question's probability (and confidence)
# together into a single joint figure; that is a reasonable reading for a
# SMALL bundle of tightly related questions (model+effort, below), but for
# many independent questions in one call (design note §6/USAGE.md's own
# fan-out guidance) the product of, say, 30 probabilities rounds to 0.00 --
# not a bug in extracting the numbers, but the wrong number to compute at
# all: USAGE.md tells the caller to withhold action below confidence
# 0.5-0.7, and a manufactured 0.00 silently defeats that check for every
# multi-question call (review finding, #1367 follow-up: hit for real,
# against production, the day after multi-question calls were documented).
#
# Stays a JSON object all the way to the last moment, reading each row
# (and each row's own fields) with jq, rather than flattening into one
# delimited string first: a `choice` name comes from whatever `questions`
# the CALLER built and is echoed straight back by the API, so it can
# contain any byte a chosen delimiter might also use, corrupting which
# value ends up where (review finding, #1364, round 2). `jq -c '.rows[]'`
# emits one COMPLETE, self-escaped JSON object per line -- jq's own
# compact encoding never puts a raw newline inside one value, so reading
# it one line at a time is safe without needing a delimiter of our own.
result_json="$(jq -c '
  (.answers // {}) as $a
  | ($a | keys_unsorted) as $ks
  | if ($a | type) != "object" or ($ks | length) == 0 then empty else
      ( [$ks[] as $k |
          # An answer that is not itself an object (e.g. a provider
          # returning a bare string for one question) makes EVERY field
          # access below -- $a[$k].choice included -- a jq RUNTIME error,
          # not a missing-value one: indexing a string or number with a
          # field name fails the whole expression, which failed the whole
          # jq CALL (review round 4: one such row took down every other
          # genuine answer along with it, silently, under set -e).
          # Checked before any field on it is ever touched.
          if ($a[$k] | type) != "object" then
            { name: $k, choice: null, p: null, confidence: null, ok: false }
          else
            ($a[$k].choice // null) as $choice |
            ($a[$k].confidence // null) as $conf |
            # A missing choice (deliberately dropped by an upstream bug, or
            # a provider quirk) makes $choice null -- indexing an object
            # with a null key is ALSO a jq runtime error, not a
            # missing-value one, so `// null` alone does not save it.
            # try/catch turns that into the same null this row already
            # renders as "malformed" from.
            (try $a[$k].probabilities[$choice] catch null) as $p | {
            name: $k,
            choice: $choice,
            p: $p,
            confidence: $conf,
            # Decided by TYPE, not by comparing the extracted VALUE to the
            # text "null" downstream: a `choice` answer can legitimately BE
            # the string "null" (a caller naming that choice in `criteria`),
            # and `jq -r` turns both a genuine JSON null and the
            # two-character string "null" into the identical output text --
            # a downstream `[ "$x" = "null" ]` cannot tell them apart
            # (review round 2). The type check runs here, on the real JSON
            # value, before anything is ever stringified.
            ok: (($choice | type) == "string" and ($p | type) == "number" and ($conf | type) == "number")
          } end
        ] ) as $rows
      | {
          rows: $rows,
          cost: (.usage.cost // null),
          input_tokens: (.usage.input_tokens // null),
          output_tokens: (.usage.output_tokens // null)
        }
    end
' "$out_file" 2>/dev/null)" || fail "jev: unexpected response shape"
rm -f "$out_file"

# The check above catches jq itself failing (a nonzero exit -- this
# assignment's own exit status, per bash's ordinary $(...) semantics); this
# one catches jq SUCCEEDING with nothing to print (an empty answers object,
# or one with no keys at all). Both are "unexpected response shape" to the
# caller, but only the first is reachable without this explicit `|| fail`:
# left as a bare assignment, a failing jq inside `$(...)` would otherwise
# just set $result_json to whatever partial/empty output it managed and let
# `set -e` end the process right there, with no diagnostic on either stream
# (review round 4).
[ -n "$result_json" ] || fail "jev: unexpected response shape"

row_count="$(jq -r '.rows | length' <<<"$result_json")"
cost_val="$(jq -r '.cost // empty' <<<"$result_json")"
in_tokens="$(jq -r '.input_tokens // empty' <<<"$result_json")"
out_tokens="$(jq -r '.output_tokens // empty' <<<"$result_json")"

# Exactly one question: same rendering as always (a joint figure over one
# term IS that term, so this is not a special case mathematically -- it is
# spelled out anyway so "the one-question reply never changes" is
# something this script visibly does, not an emergent property to trust).
# A malformed sole answer still fails the whole call -- there is nothing
# else in the reply to salvage it with, unlike the 2+ case below.
if [ "$row_count" -eq 1 ]; then
  ok_val="$(jq -r '.rows[0].ok' <<<"$result_json")"
  [ "$ok_val" = "true" ] || fail "jev: unexpected response shape"
  choices="$(jq -r '.rows[0].choice' <<<"$result_json")"
  p_val="$(jq -r '.rows[0].p' <<<"$result_json")"
  c_val="$(jq -r '.rows[0].confidence' <<<"$result_json")"
  if [ "$provider" = "typesafe" ]; then
    [ -n "$in_tokens" ] && [ -n "$out_tokens" ] || fail "jev: unexpected response shape"
    printf -v reply_line 'jev: %s (choice p=%.2f, confidence=%.2f, tokens %s in / %s out)' \
      "$choices" "$p_val" "$c_val" "$in_tokens" "$out_tokens"
  else
    [ -n "$cost_val" ] || fail "jev: unexpected response shape"
    printf -v reply_line 'jev: %s (choice p=%.2f, confidence=%.2f, cost $%.6f)' \
      "$choices" "$p_val" "$c_val" "$cost_val"
  fi
  printf '%s\n' "$(_jev_one_line "$reply_line")"
else
  # Two or more: one LINE per question, `name=choice (p=.., confidence=..)`,
  # addressable by NAME (the sender's own `questions` key) rather than by
  # position -- position silently breaks the moment the endpoint (or a
  # future request) reorders answers; a name cannot. Each line goes through
  # _jev_one_line on its own, same as every other line this script ever
  # prints, so one answer's caller-controlled choice name cannot inject a
  # line break that reads as a further (fake) answer.
  #
  # A single malformed row -- missing choice, or a choice absent from its
  # own probabilities -- no longer fails the WHOLE call: it renders as its
  # own `name=error (malformed answer)` line, and every other question's
  # real answer still comes back. Failing the entire batch over one bad
  # row would throw away N-1 good answers along with it, and the caller
  # already has to read each row's own name regardless.
  lines=()
  while IFS= read -r row; do
    seg_name="$(jq -r '.name' <<<"$row")"
    seg_ok="$(jq -r '.ok' <<<"$row")"
    if [ "$seg_ok" != "true" ]; then
      printf -v line '%s=error (malformed answer)' "$seg_name"
    else
      seg_choice="$(jq -r '.choice' <<<"$row")"
      seg_p="$(jq -r '.p' <<<"$row")"
      seg_c="$(jq -r '.confidence' <<<"$row")"
      printf -v line '%s=%s (p=%.2f, confidence=%.2f)' "$seg_name" "$seg_choice" "$seg_p" "$seg_c"
    fi
    lines+=("$(_jev_one_line "$line")")
  done < <(jq -c '.rows[]' <<<"$result_json")

  # The call's own aggregate cost/tokens, same figure as before -- appended
  # to the LAST line rather than repeated on every one, since it describes
  # the whole call, not any single question.
  if [ "$provider" = "typesafe" ]; then
    [ -n "$in_tokens" ] && [ -n "$out_tokens" ] || fail "jev: unexpected response shape"
    printf -v suffix ' (tokens %s in / %s out)' "$in_tokens" "$out_tokens"
  else
    [ -n "$cost_val" ] || fail "jev: unexpected response shape"
    printf -v suffix ' (cost $%.6f)' "$cost_val"
  fi
  last=$(( ${#lines[@]} - 1 ))
  lines[last]="${lines[last]}$suffix"

  printf 'jev: %s\n' "${lines[0]}"
  for ((idx = 1; idx < ${#lines[@]}; idx++)); do
    printf '%s\n' "${lines[$idx]}"
  done
fi
