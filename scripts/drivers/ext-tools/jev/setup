#!/usr/bin/env bash
set -euo pipefail

# setup — non-conversational setup commands for the Jev ext-tool, driven by
# the seat LLM per SETUP.md (design note §5b). Every subcommand takes
# explicit paths/values as arguments rather than assuming a config file
# already exists -- `save` is what creates the member config, so nothing
# before it can read one.
#
# Usage:
#   setup status <config_path>
#   setup check key <key_file>
#   setup save <config_path> <key_file> [provider]
#   setup test <config_path>
#
# `check key` only confirms the file EXISTS and is READABLE at that
# location, per the maintainer's instruction -- it does not call the real
# API (that is `test`'s job, and only a human runs that, with a real key).
# Never prints the key itself.
#
# [provider] is openrouter or typesafe (maintainer decision, 2026-09-21);
# omitted or empty means openrouter, so an existing member config with no
# provider= line at all keeps working exactly as before. A member's own
# key_file/provider pair always travels together in ONE config, which is
# what keeps a key saved for one provider from ever being sent to the
# other's endpoint.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_lib.sh"

die() { echo "setup: $*" >&2; exit 1; }

cmd="${1:?Usage: setup status|check|save|test ...}"
shift

cmd_status() {
  local config_path="${1:?Usage: setup status <config_path>}" required key provider
  required="$(_jev_conf_get "$SCRIPT_DIR/tool.conf" required_config 2>/dev/null || true)"
  [ -n "$required" ] || required="key_file"
  local items="" sep=""
  for key in $required; do
    if [ -z "$(_jev_conf_get "$config_path" "$key")" ]; then
      items="${items}${sep}\"$key\""
      sep=","
    fi
  done
  provider="$(_jev_conf_get "$config_path" provider)"
  [ -n "$provider" ] || provider="openrouter"
  jq -cn --argjson missing "[$items]" --arg provider "$provider" '{missing: $missing, provider: $provider}'
}

cmd_check_key() {
  local key_file="${1:?Usage: setup check key <key_file>}"
  if [ ! -f "$key_file" ]; then
    jq -cn --arg err "key file not found: $key_file" '{ok: false, error: $err}'
    return 1
  fi
  if [ ! -r "$key_file" ]; then
    jq -cn --arg err "key file not readable: $key_file" '{ok: false, error: $err}'
    return 1
  fi
  _jev_read_key "$key_file" || {
    jq -cn --arg err "$_JEV_KEY_ERROR" '{ok: false, error: $err}'
    return 1
  }
  jq -cn '{ok: true}'
}

cmd_save() {
  local config_path="${1:?Usage: setup save <config_path> <key_file> [provider]}" \
    key_file="${2:?Usage: setup save <config_path> <key_file> [provider]}" \
    provider="${3:-}"
  [ -r "$key_file" ] || die "key file not readable: $key_file"
  if [ -n "$provider" ]; then
    case "$provider" in
      openrouter|typesafe) : ;;
      *) die "unknown provider: $provider (expected openrouter or typesafe)" ;;
    esac
  fi
  mkdir -p "$(dirname "$config_path")"
  umask 077
  {
    printf 'key_file=%s\n' "$key_file"
    [ -z "$provider" ] || printf 'provider=%s\n' "$provider"
  } > "$config_path"
  chmod 600 "$config_path"
  printf '{"ok":true,"config_path":"%s"}\n' "$config_path"
}

# setup test calls the REAL endpoint once (never in CI -- design note §5b:
# only a human, locally, with a real key) and shows the actual raw answer,
# so a person can confirm the whole path works end to end. Prints whatever
# the provider actually returned as-is -- it does not reshape this into
# handle's one-line reply format, so it needs no provider-specific output
# branching the way handle's cost-vs-tokens decision does.
cmd_test() {
  local config_path="${1:?Usage: setup test <config_path>}" \
    key_file key provider model url questions_json state_json request_json out_file
  key_file="$(_jev_conf_get "$config_path" key_file)"
  if [ -z "$key_file" ]; then
    jq -cn '{ok: false, error: "member config is missing key_file"}'
    return 1
  fi
  _jev_read_key "$key_file" || {
    jq -cn --arg err "$_JEV_KEY_ERROR" '{ok: false, error: $err}'
    return 1
  }
  key="$_JEV_KEY"

  provider="$(_jev_conf_get "$config_path" provider)"
  [ -n "$provider" ] || provider="openrouter"
  case "$provider" in
    openrouter|typesafe) : ;;
    *)
      # Without this, an unrecognized value would silently fall through
      # _jev_provider_*'s wildcard case to openrouter's URL/model and send
      # this member's real key there regardless of what was actually
      # configured (review finding, #1364) -- reject it here, before any
      # URL is built, the same way handle does.
      jq -cn --arg p "$provider" '{ok: false, error: ("unknown provider in member config: " + $p + " (expected openrouter or typesafe)")}'
      return 1
      ;;
  esac

  # A minimal, self-contained question -- there is no bundled example
  # question file to read anymore; this is only exercised here, as a
  # connectivity check, never by handle.
  questions_json='{"size":{"type":"choice","instructions":"Pick the size of this change.","criteria":{"small":"a one-line, fully specified edit","large":"work spanning multiple files or decisions"}}}'
  state_json='"agmsg jev setup test: fix a one-line typo in a README."'
  model="$(_jev_provider_default_model "$provider")"
  request_json="$(jq -cn --arg model "$model" --argjson state "$state_json" \
    --argjson questions "$questions_json" '{model: $model, state: $state, questions: $questions}')"

  url="$(_jev_api_base "$provider")$(_jev_provider_path "$provider")"
  out_file="$(mktemp "${TMPDIR:-/tmp}/agmsg-jev-setup.XXXXXX")"
  if ! _jev_api_call "$key" "$request_json" "$out_file" "$url"; then
    jq -cn --arg err "$_JEV_CURL_DIAG" '{ok: false, error: ("request failed: " + $err)}'
    rm -f "$out_file"
    return 1
  fi
  case "$_JEV_HTTP_CODE" in
    401) jq -cn '{ok: false, error: "invalid API key (HTTP 401)"}'; rm -f "$out_file"; return 1 ;;
    429) jq -cn '{ok: false, error: "rate limited (HTTP 429)"}'; rm -f "$out_file"; return 1 ;;
    2??) : ;;
    *) jq -cn --arg c "$_JEV_HTTP_CODE" '{ok: false, error: ("unexpected HTTP " + $c)}'; rm -f "$out_file"; return 1 ;;
  esac
  cat "$out_file"
  rm -f "$out_file"
}

case "$cmd" in
  status) cmd_status "$@" ;;
  check)
    sub="${1:?Usage: setup check key ...}"; shift
    case "$sub" in
      key) cmd_check_key "$@" ;;
      *) die "unknown check: $sub (expected key)" ;;
    esac
    ;;
  save) cmd_save "$@" ;;
  test) cmd_test "$@" ;;
  *) die "unknown command: $cmd (expected status, check, save, or test)" ;;
esac
