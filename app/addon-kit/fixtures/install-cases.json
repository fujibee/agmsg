{
 "version": 1,
 "description": "Shared by the app's Rust installer (src/addons/install) and the author check (addon-kit/agmsg-addon-check.cjs). Each case is a tree (entries) and the exact error list both must produce. 'archiveOnly' cases cannot exist as a directory and are only run through the archive extractor.",
 "cases": [
  {
   "name": "a plain layout is accepted",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    }
   ],
   "expect": {
    "errors": []
   },
   "extract": "ok"
  },
  {
   "name": "a symbolic link is refused",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/link",
     "type": "symlink",
     "target": "/etc/hosts"
    }
   ],
   "expect": {
    "errors": [
     "Refused: the repository contains a symbolic link at app-panes/x/web/link. Add-ons may contain only plain files."
    ]
   },
   "extract": {
    "error": "Refused: the repository contains a symbolic link at app-panes/x/web/link. Add-ons may contain only plain files."
   }
  },
  {
   "name": "a hard link is refused (both names in a directory, the link entry in an archive)",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/a.txt",
     "type": "file",
     "text": "same"
    },
    {
     "path": "app-panes/x/web/b.txt",
     "type": "hardlink",
     "of": "app-panes/x/web/a.txt"
    }
   ],
   "expect": {
    "errors": [
     "Refused: the repository contains a hard link at app-panes/x/web/a.txt. Add-ons may contain only plain files.",
     "Refused: the repository contains a hard link at app-panes/x/web/b.txt. Add-ons may contain only plain files."
    ]
   },
   "extract": {
    "error": "Refused: the repository contains a hard link at app-panes/x/web/b.txt. Add-ons may contain only plain files."
   }
  },
  {
   "name": "a Windows device name is refused",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/CON.txt",
     "type": "file",
     "text": "x"
    }
   ],
   "expect": {
    "errors": [
     "Refused: the repository contains a reserved file name at app-panes/x/web/CON.txt. Add-ons may contain only plain files."
    ]
   },
   "extract": {
    "error": "Refused: the repository contains a reserved file name at app-panes/x/web/CON.txt. Add-ons may contain only plain files."
   }
  },
  {
   "name": "a name ending in a dot is refused",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/x.",
     "type": "file",
     "text": "x"
    }
   ],
   "expect": {
    "errors": [
     "Refused: the repository contains a reserved file name at app-panes/x/web/x.. Add-ons may contain only plain files."
    ]
   },
   "extract": {
    "error": "Refused: the repository contains a reserved file name at app-panes/x/web/x.. Add-ons may contain only plain files."
   }
  },
  {
   "name": "an alternate data stream name is refused",
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/a:b",
     "type": "file",
     "text": "x"
    }
   ],
   "expect": {
    "errors": [
     "Refused: the repository contains a reserved file name at app-panes/x/web/a:b. Add-ons may contain only plain files."
    ]
   },
   "extract": {
    "error": "Refused: the repository contains a reserved file name at app-panes/x/web/a:b. Add-ons may contain only plain files."
   }
  },
  {
   "name": "too many files",
   "limits": {
    "files": 4
   },
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/1.js",
     "type": "file",
     "text": "1"
    },
    {
     "path": "app-panes/x/web/2.js",
     "type": "file",
     "text": "2"
    }
   ],
   "expect": {
    "errors": [
     "Too large to install: 5 files (limit 4)."
    ]
   },
   "extract": {
    "contains": [
     "Too large to install:",
     "files (limit 4)."
    ]
   }
  },
  {
   "name": "a file over the per-file limit",
   "limits": {
    "fileBytes": 1048576
   },
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/big.bin",
     "type": "file",
     "size": 2097152
    }
   ],
   "expect": {
    "errors": [
     "Too large to install: app-panes/x/web/big.bin is 2.0 MB (limit 1.0 MB per file)."
    ]
   },
   "extract": {
    "contains": [
     "Too large to install:",
     "app-panes/x/web/big.bin",
     "(limit 1.0 MB per file)."
    ]
   }
  },
  {
   "name": "over the total limit names the largest file",
   "limits": {
    "totalBytes": 3145728
   },
   "entries": [
    {
     "path": "agmsg-plugin.conf",
     "type": "file",
     "text": "name = x\n"
    },
    {
     "path": "app-panes/x/addon.conf",
     "type": "file",
     "text": "title = X\nprotocol = 1\n"
    },
    {
     "path": "app-panes/x/web/index.html",
     "type": "file",
     "text": "<div></div>"
    },
    {
     "path": "app-panes/x/web/a.bin",
     "type": "file",
     "size": 2097152
    },
    {
     "path": "app-panes/x/web/b.bin",
     "type": "file",
     "size": 2097153
    }
   ],
   "expect": {
    "errors": [
     "Too large to install: 4.0 MB (limit 3.0 MB). Largest file: app-panes/x/web/b.bin (2.0 MB)."
    ]
   },
   "extract": {
    "contains": [
     "Too large to install:",
     "(limit 3.0 MB).",
     "Largest file"
    ]
   }
  },
