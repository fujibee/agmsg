{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-pty-inject",
    "allow-agent-state",
    "allow-login-shell",
    "allow-agmsg-is-installed",
    "allow-agmsg-install",
    "allow-agmsg-core-version-status",
    "allow-agmsg-update-core",
    "allow-agmsg-teams",
    "allow-agmsg-members",
    "allow-agmsg-messages",
    "allow-agmsg-send",
    "allow-agmsg-join",
    "allow-agmsg-rename",
    "allow-agmsg-leave",
    "allow-agmsg-rename-team",
    "allow-agmsg-delete-team",
    "allow-agmsg-delete-team-force",
    "allow-agmsg-purge-team-messages",
    "allow-agmsg-delivery-mode",
    "allow-agmsg-default-project",
    "allow-agmsg-command-name",
    "allow-agmsg-spawnable-types",
    "allow-set-menu-language",
    "allow-set-team-room-visible",
    "allow-set-user-chat-visible",
    "allow-view-visibility",
    "allow-addon-canary",
    "allow-addon-channel-feed"
  ]
}